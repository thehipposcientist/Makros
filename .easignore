# EAS build archive ignore list. When present, EAS uses THIS instead of
# .gitignore to decide what goes into the local build tarball, so it must be a
# superset of .gitignore. Paired with EAS_NO_VCS=1 in the Makefile so eas-cli
# copies the working dir directly instead of cloning the 36 GB .git history
# (which made "Compressing project files" hang).

# ── never archive git history (the whole reason for EAS_NO_VCS) ──
.git/

# dependencies
node_modules/
node_modules.deploy-stale-*/
.pnp
.pnp.js

# testing
coverage/
assets/test/
src/**/__tests__/

# build output
build/
dist/
dist-web/

# native build artifacts — regenerated by the build, never needed in the bundle
*.ipa
*.apk
*.aab
*.dump
*.hprof
*.jsbundle
*.iml
ios/DerivedData/
ios/build/
ios/Pods/
ios/.xcode.env.local
ios/xcuserdata/
ios/*.xcworkspace/xcuserdata/
*.xcuserstate
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/app/.externalNativeBuild/
android/local.properties
.cxx/
.externalNativeBuild/
targets/resttimer-widget/Assets.xcassets/AppIcon.appiconset/ItunesArtwork@2x.png
ios/Thallo/Images.xcassets/SplashScreenLogo.imageset/SplashScreenLogo.png
assets/images/card-backgrounds/workout-card-rest-day-male.jpg
assets/images/equipment/pec_deck_machine_alt_2.png
assets/images/equipment/plate_loaded_chest_press_machine_alt_3.png
assets/images/equipment/yoga_mat_alt_1.png
assets/images/landing-photos/pexels-hiking-forest-woman.jpg
assets/images/landing-photos/pexels-neon-gym-woman-11896016.jpg

# large source-only input zip (generated runtime output is tracked, not this)
assets/full-library.zip

# repo-only material that is not used by the native app build
CLAUDE.md
start-tunnel.bat
android/
backend/
docs/
marketing/
patches/
.claude/
.maestro/
.ps_tmp/

# env / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/workoutpal.db
backend/venv/

# python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# expo
.expo/
.expo-shared/
expo-env.d.ts

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
