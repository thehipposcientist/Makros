<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Thallo</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>thallo</string>
          <string>com.thallo.app</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>exp+thallo</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>140</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
      <key>NSAllowsLocalNetworking</key>
      <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Thallo uses the camera to scan food barcodes, take food photos for nutrition tracking, and capture photos of your gear (running shoes, bikes) for AI mileage estimates.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Thallo uses Face ID to unlock the app quickly so you don't have to retype your password every session.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Thallo reads Apple Health categories you choose, including sleep, heart rate, HRV, steps, workouts, weight, energy, VO2 max, respiratory rate, blood oxygen, standing hours, mindful minutes, and menstrual-flow data for readiness, recovery, progress trends, and optional cycle-aware guidance.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Thallo writes completed workouts, workout energy, and workout distance to Apple Health so Thallo sessions can appear alongside your other activity.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Thallo uses the microphone for speech-to-meal voice entry — speak what you ate and we'll log it without typing.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Thallo accesses your photo library to attach gear photos for AI mileage tracking and to add food photos to logged meals.</string>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>RCTNewArchEnabled</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
      <string>audio</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>SplashScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
  </dict>
</plist>
