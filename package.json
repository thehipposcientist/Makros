{
  "name": "thallo",
  "version": "0.1.0",
  "description": "Macro and workout tracking app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-dependency-policy.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:frontend": "node scripts/run-frontend-tests.mjs",
    "test:android:smoke": "node scripts/run-android-emulator-smoke.mjs",
    "test:android:platform": "make smoke-mobile-android-platform",
    "test:backend": "make test",
    "eas-build-post-install": "node scripts/sync-ios-build-versions.mjs",
    "verify:beta": "npm run check:deps && npm run typecheck && npm run test:frontend && npx expo-doctor && npm run test:backend"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-purchases": "^10.1.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "12.0.9",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "thallo-healthkit": "file:modules/thallo-healthkit",
    "thallo-live-activity": "file:modules/thallo-live-activity",
    "thallo-watch-bridge": "file:modules/thallo-watch-bridge"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@bacons/apple-targets": "^4.0.6",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
